# Lumina Logistics - frontend configuration
# Copy to ".env" and fill in real values.

# OpenRouteService key (real road routing)
VITE_ORS_API_KEY="eyJvcmciOiI1YjNjZTM1OTc4NTExMTAwMDFjZjYyNDgiLCJpZCI6ImI1OGUzN2M5NTQ5YjRlZjU4NjEzNDU5MWRlMGY2ZDEzIiwiaCI6Im11cm11cjY0In0="

# CARTO Basemaps key (optional - if omitted, OpenStreetMap dark-mode tiles are used without an API key)
