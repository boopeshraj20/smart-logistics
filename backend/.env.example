# Lumina Logistics - backend configuration
# Copy to ".env" and fill in real values.

APP_NAME="Lumina Logistics API"
DEBUG=false

# Comma-separated origins are not accepted by pydantic-settings for list fields.
# Use a JSON array in the hosting provider's environment settings instead:
# CORS_ORIGINS=["https://your-app.vercel.app"]

# OpenRouteService free-tier key (real road routing on OpenStreetMap data)
ORS_API_KEY=""
ORS_BASE_URL="https://api.openrouteservice.org"
# driving-hgv (heavy goods vehicle) or driving-car
ORS_PROFILE="driving-hgv"

# Economic model defaults
VEHICLE_AVG_SPEED_KMH=48.0
FUEL_PRICE_PER_L=90.5
CO2_PER_LITRE_FUEL=2.68